<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily newsletter send — job starts 3:40 AM PT so the email still lands ~4:00
  after the Fable editorial pass (~7-8 min) plus pre-send first-party QA.
  A timeout degrades to the assembled build, never a missed send.

  scheduled-send.mjs holds the shared Mini repo lock, fetches origin/main,
  safely fast-forwards a clean behind checkout, and fails closed on dirty,
  diverged, or locally modified source before it invokes send.mjs.

  Node runs as a child of /bin/zsh, never as the launchd program itself: after
  `brew upgrade node`, macOS SIGKILLs the next direct launch with "Launch
  Constraint Violation", which is how the 2026-09-20 issue never sent. See
  scripts/social/default-plans-refresh.plist.

  Install on the Mini:
    cp scripts/newsletter/newsletter-send.plist ~/Library/LaunchAgents/org.southbaytoday.newsletter-send.plist
    launchctl bootout gui/$(id -u)/org.southbaytoday.newsletter-send 2>/dev/null || true
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/org.southbaytoday.newsletter-send.plist

  Logs: /tmp/sbt-newsletter-send.{out,err}.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.southbaytoday.newsletter-send</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-f</string>
        <string>-c</string>
        <string>/opt/homebrew/bin/node /Users/stephenstanwood/Projects/southbaytoday.org/scripts/newsletter/scheduled-send.mjs; exit $?</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/stephenstanwood/Projects/southbaytoday.org</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>40</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/sbt-newsletter-send.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/sbt-newsletter-send.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
