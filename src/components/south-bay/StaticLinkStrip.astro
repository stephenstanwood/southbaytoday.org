---
// Quiet static link blocks rendered below the app on tab/city pages. The
// point is crawl-graph: the high-authority app URLs pass internal links into
// the static layer (day listings, council pages, food openings). Pure HTML —
// renders pre-hydration and for crawlers; visually it reads as a sitemap-ish
// footer extension, deliberately understated. RSS / About / Privacy used to
// trail the day links; SiteFooter (server-rendered on every page that uses
// this strip) already carries all three, so they aren't repeated here.
import upcomingData from "../../data/south-bay/upcoming-events.json";
import digestsJson from "../../data/south-bay/digests.json";

interface Props {
  days?: boolean;
  govCities?: boolean;
  foodNew?: boolean;
}

const { days = false, govCities = false, foodNew = false } = Astro.props;

const todayPt = new Date().toLocaleDateString("en-CA", { timeZone: "America/Los_Angeles" });
const eventDates = days
  ? [...new Set(
      ((upcomingData as { events?: { date?: string; time?: string }[] }).events ?? [])
        .filter((e) => e.date && e.time && e.date >= todayPt)
        .map((e) => e.date as string),
    )]
      .sort()
      .slice(0, 14)
  : [];

const dayLabel = (d: string) =>
  new Date(`${d}T12:00:00Z`).toLocaleDateString("en-US", { timeZone: "UTC", weekday: "short", month: "short", day: "numeric" });

const govCityList = govCities
  ? Object.values(digestsJson as Record<string, { city: string; cityName: string }>)
      .map((d) => ({ id: d.city, name: d.cityName }))
      .sort((a, b) => a.name.localeCompare(b.name))
  : [];
---

{(eventDates.length > 0 || govCityList.length > 0 || foodNew) && (
  <nav class="sls" aria-label="Browse the site">
    {eventDates.length > 0 && (
      <div class="sls-row">
        <p class="sls-label">Events by day</p>
        <p class="sls-links">
          {eventDates.map((d) => <a href={`/events/${d}`}>{dayLabel(d)}</a>)}
        </p>
      </div>
    )}
    {govCityList.length > 0 && (
      <div class="sls-row">
        <p class="sls-label">Council summaries</p>
        <p class="sls-links">
          {govCityList.map((c) => <a href={`/gov/${c.id}`}>{c.name}</a>)}
        </p>
      </div>
    )}
    {foodNew && (
      <div class="sls-row">
        <p class="sls-label">Food</p>
        <p class="sls-links">
          <a href="/food/new">New &amp; coming-soon restaurants</a>
        </p>
      </div>
    )}
  </nav>
)}

<style>
  /* A quiet, centered sitemap under the footer: small mono label over a
     wrapped row of links, same muted voice as the footer meta line. */
  .sls {
    max-width: 760px;
    margin: 0 auto;
    padding: 6px var(--sb-gutter) 40px;
    text-align: center;
  }
  .sls-row + .sls-row {
    margin-top: 16px;
  }
  .sls-label {
    margin: 0 0 4px;
    font-family: var(--sb-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sb-muted);
  }
  .sls-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 14px;
    margin: 0;
    font-size: 12.5px;
    line-height: 1.4;
  }
  .sls a {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 3px;
    color: var(--sb-light);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s;
  }
  .sls a:hover {
    color: var(--sb-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* Phones: 40px tap rows, and room at the bottom so the fixed Tips &
     Feedback button never sits on the last links. */
  @media (max-width: 640px) {
    .sls {
      padding-bottom: calc(76px + env(safe-area-inset-bottom));
    }
    .sls-links {
      gap: 0 6px;
    }
    .sls a {
      min-height: 40px;
      padding: 0 6px;
    }
  }
</style>
