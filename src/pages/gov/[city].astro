---
// Static per-city council pages — plain-English digest of the latest meeting
// plus the next agenda. This coverage exists nowhere else on the web, so these
// pages are the site's strongest unique-content surface. Pure Astro; content
// refreshes whenever the council pipeline writes a new digest.
import CalendarShell from "../../layouts/CalendarShell.astro";
import digestsJson from "../../data/south-bay/digests.json";
import meetingsJson from "../../data/south-bay/upcoming-meetings.json";
import { CITY_MAP } from "../../lib/south-bay/cities";
import {
  CIVIC_EVENT_IMAGE_URL,
  civicMeetingToSchema,
} from "../../lib/south-bay/civicMeetingSchema";
import type { City } from "../../lib/south-bay/types";

interface Digest {
  city: string;
  cityName: string;
  body: string;
  meetingDate: string;
  meetingDateIso: string;
  title: string;
  summary: string;
  keyTopics?: string[];
  schedule?: string | null;
  sourceUrl?: string | null;
}

interface Meeting {
  date?: string;
  displayDate?: string;
  bodyName?: string;
  location?: string;
  url?: string;
  agendaItems?: { title: string }[];
}

export function getStaticPaths() {
  const digests = digestsJson as Record<string, Digest>;
  return Object.keys(digests).map((city) => ({
    params: { city },
    props: { digest: digests[city] },
  }));
}

interface Props {
  digest: Digest;
}

const { digest } = Astro.props;
const cityId = digest.city;
const cityName = digest.cityName;
const meeting = ((meetingsJson as unknown as { meetings?: Record<string, Meeting> }).meetings ?? {})[cityId] ?? null;

const meetingDayLabel = meeting?.date
  ? new Date(`${meeting.date}T12:00:00Z`).toLocaleDateString("en-US", {
      timeZone: "UTC",
      weekday: "long",
      month: "long",
      day: "numeric",
      year: "numeric",
    })
  : null;

// Same predicate the body uses to decide between the "next meeting" card and
// the no-meeting-confirmed fallback, so the <title> promise never disagrees
// with what the page actually renders.
const hasConfirmedMeeting = Boolean(meeting && meetingDayLabel);

const title = hasConfirmedMeeting
  ? `${cityName} City Council — meeting summaries & next agenda — South Bay Today`
  : `${cityName} City Council — meeting summaries — South Bay Today`;

// Trim to a word boundary rather than slicing mid-word, and use a real
// ellipsis instead of implying the sentence just stops.
function truncateAtWord(text: string, maxLen: number): string {
  if (text.length <= maxLen) return text;
  const cut = text.slice(0, maxLen);
  const lastSpace = cut.lastIndexOf(" ");
  return `${cut.slice(0, lastSpace > 0 ? lastSpace : maxLen)}…`;
}
const description = truncateAtWord(digest.summary, 155);
const cityWebsite = CITY_MAP[cityId as City]?.website;

const schemas: Record<string, unknown>[] = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "South Bay Today", item: "https://southbaytoday.org" },
      { "@type": "ListItem", position: 2, name: "Local Government", item: "https://southbaytoday.org/gov" },
      { "@type": "ListItem", position: 3, name: `${cityName} City Council`, item: `https://southbaytoday.org/gov/${cityId}` },
    ],
  },
];
const meetingSchema = civicMeetingToSchema({ cityId, cityName, cityWebsite, meeting });
if (meetingSchema) schemas.push(meetingSchema);
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": schemas });

const agendaPreview = (meeting?.agendaItems ?? []).slice(0, 8);
---

<CalendarShell
  title={title}
  description={description}
  ogImage={CIVIC_EVENT_IMAGE_URL}
  activeTab="government"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  <nav class="cal-daynav" aria-label="Breadcrumb">
    <a href="/gov">← All cities</a>
    <span class="cal-kicker">South Bay / Civic Desk</span>
    <span />
  </nav>

  <h1>{cityName} City Council</h1>
  <p class="cal-sub">
    Plain-English summaries of {cityName} council meetings, updated as agendas and
    minutes post{digest.schedule ? ` · meets ${digest.schedule}` : ""} ·{" "}
    <a href={`/city/${cityId}`}>everything in {cityName} →</a>
  </p>

  {meeting && meetingDayLabel ? (
    <section class="gcity-next" aria-labelledby="gcity-next-heading">
      <h2 id="gcity-next-heading" class="gcity-next-head">
        <span class="gcity-kicker">Next meeting</span>
        <span class="gcity-next-date">{meetingDayLabel}</span>
      </h2>
      {agendaPreview.length > 0 ? (
        <>
          <h3 class="gcity-subhead">On the agenda</h3>
          <ul class="gcity-list">
            {agendaPreview.map((item) => (
              <li>{item.title}</li>
            ))}
          </ul>
        </>
      ) : (
        <p class="gcity-muted">Agenda not posted yet. Check the city's calendar closer to the date.</p>
      )}
      {meeting.url && (
        <a class="sb-btn sb-btn--primary gcity-next-cta" href={meeting.url} rel="noopener noreferrer">
          Full agenda ↗
        </a>
      )}
    </section>
  ) : (
    <section class="gcity-next gcity-next--empty" aria-labelledby="gcity-next-heading">
      <h2 id="gcity-next-heading" class="gcity-next-head">
        <span class="gcity-kicker">Next meeting</span>
      </h2>
      <p class="gcity-muted">
        No upcoming meeting confirmed yet. Check the{" "}
        {cityWebsite ? (
          <a href={cityWebsite} rel="noopener noreferrer">city's calendar ↗</a>
        ) : (
          "city's calendar"
        )}.
      </p>
    </section>
  )}

  <article class="gcity-digest" aria-labelledby="gcity-digest-heading">
    <p class="gcity-kicker">Latest meeting</p>
    <h2 id="gcity-digest-heading" class="gcity-digest-title">{digest.body} · {digest.meetingDate}</h2>
    <p class="gcity-summary">{digest.summary}</p>
    {(digest.keyTopics ?? []).length > 0 && (
      <>
        <h3 class="gcity-subhead">What came up</h3>
        <ul class="gcity-list gcity-list--topics">
          {(digest.keyTopics ?? []).map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </>
    )}
    <p class="gcity-source">
      Summarized from the official record.
      {digest.sourceUrl && (
        <>
          {" "}
          <a href={digest.sourceUrl} rel="noopener noreferrer">Agendas &amp; minutes ↗</a>
        </>
      )}
    </p>
  </article>

  <div class="gcity-actions">
    <a class="sb-btn" href="/gov">← All South Bay councils</a>
    <a class="sb-btn sb-btn--quiet" href={`/city/${cityId}`}>{cityName} today →</a>
  </div>
</CalendarShell>

<style>
  /* /gov/<city> — page-specific pieces. The masthead, breadcrumb, h1, and
     .cal-sub intro come from CalendarShell; buttons are the house .sb-btn. */
  .gcity-kicker {
    display: block;
    margin: 0;
    font-family: var(--sb-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sb-accent-ink);
  }

  .gcity-next {
    margin: 0 0 30px;
    padding: 22px 24px 24px;
    border: 1px solid var(--sb-line);
    border-radius: var(--sb-radius-md);
    background: var(--sb-card);
    box-shadow: var(--sb-shadow-sm);
  }

  .gcity-next-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
  }

  .gcity-next-date {
    font-family: var(--sb-serif);
    font-size: 24px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--sb-ink);
    text-wrap: balance;
  }

  .gcity-next--empty .gcity-muted {
    margin-top: 8px;
  }

  .gcity-next-cta {
    margin-top: 18px;
  }

  .gcity-subhead {
    margin: 20px 0 10px;
    font-family: var(--sb-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sb-muted);
  }

  .gcity-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gcity-list li {
    position: relative;
    padding-left: 20px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--sb-ink);
    text-wrap: pretty;
  }

  .gcity-list li::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sb-accent);
    opacity: 0.6;
  }

  .gcity-muted {
    margin: 12px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--sb-muted);
  }

  .gcity-muted a,
  .gcity-source a {
    white-space: nowrap;
    color: var(--sb-ink-2);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--sb-line-strong);
    text-underline-offset: 3px;
  }

  .gcity-muted a:hover,
  .gcity-source a:hover {
    color: var(--sb-accent-ink);
    text-decoration-color: currentColor;
  }

  .gcity-digest {
    padding-bottom: 26px;
    border-bottom: 1px solid var(--sb-line);
  }

  .gcity-digest-title {
    margin: 8px 0 14px;
    font-family: var(--sb-serif);
    font-size: 26px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--sb-ink);
    text-wrap: balance;
  }

  .gcity-summary {
    max-width: 64ch;
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--sb-ink-2);
    text-wrap: pretty;
  }

  .gcity-list--topics {
    max-width: 64ch;
  }

  .gcity-list--topics li {
    font-size: 15.5px;
    color: var(--sb-ink-2);
  }

  .gcity-source {
    margin: 22px 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--sb-light);
  }

  .gcity-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  @media (max-width: 540px) {
    .gcity-next {
      padding: 18px 18px 20px;
    }

    .gcity-next-date {
      font-size: 21px;
    }

    .gcity-digest-title {
      font-size: 22px;
    }

    .gcity-summary {
      font-size: 16px;
    }

    .gcity-list--topics li {
      font-size: 15px;
    }

    .gcity-actions .sb-btn {
      flex: 1 1 auto;
      min-height: 44px;
    }
  }
</style>
