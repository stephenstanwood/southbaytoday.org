---
// Per-event detail pages — one stable URL per upcoming event, with a single
// schema.org Event block. These are the long-tail crawl surface ("event name
// + city" queries); the page links out prominently to the source. Pure Astro.
import CalendarShell from "../../layouts/CalendarShell.astro";
import upcomingData from "../../data/south-bay/upcoming-events.json";
import archiveData from "../../data/south-bay/events-archive.json";
import retiredData from "../../data/south-bay/events-retired.json";
import { CITIES } from "../../lib/south-bay/cities";
import { buildGoogleCalendarUrl } from "../../lib/south-bay/calendarLink";
import { buildEventSlugs } from "../../lib/south-bay/eventSlug";
import { resolveRetired } from "../../lib/south-bay/eventSlugLedger.mjs";
import { eventToSchema, type SchemaEventRecord } from "../../lib/south-bay/eventSchema";
import { isVirtualEvent } from "../../lib/south-bay/eventFilters.mjs";
import { normalizeAbsoluteHttpUrl } from "../../lib/south-bay/httpUrl.mjs";

interface RawEvent {
  id?: string | null;
  title?: string | null;
  date?: string | null;
  time?: string | null;
  endTime?: string | null;
  venue?: string | null;
  address?: string | null;
  city?: string | null;
  url?: string | null;
  image?: string | null;
  photoRef?: string | null;
  blurb?: string | null;
  description?: string | null;
  attendanceNote?: string | null;
  cost?: string | null;
  costNote?: string | null;
  kidFriendly?: boolean | null;
  category?: string | null;
  source?: string | null;
  virtual?: boolean | null;
}

export function getStaticPaths() {
  const all = (upcomingData as { events?: RawEvent[] }).events ?? [];
  const archived = (archiveData as { events?: RawEvent[] }).events ?? [];
  const todayPt = new Date().toLocaleDateString("en-CA", { timeZone: "America/Los_Angeles" });
  const upcoming = all.filter((e) => e.date && e.date >= todayPt && e.time);
  // Passed events keep resolving for the archive window (90 days) with a
  // "this event has passed" banner — no next-morning 404s. Upcoming wins when
  // a recurring event appears in both pools.
  const past = archived.filter((e) => e.date && e.date < todayPt && e.time);
  const seen = new Set(upcoming.map((e) => `${e.date}|${e.title}`));
  const pool = [...upcoming, ...past.filter((e) => !seen.has(`${e.date}|${e.title}`))];
  const livePages = [...buildEventSlugs(pool)].map(([slug, event]) => ({
    params: { slug },
    props: {
      event,
      passed: Boolean(event.date && event.date < todayPt),
      retired: false,
      updatedAt: event.date && event.date < todayPt
        ? (archiveData as { updatedAt?: string }).updatedAt ?? null
        : (upcomingData as { generatedAt?: string }).generatedAt ?? null,
    },
  }));
  // Slugs that left the feed before their date (events-retired.json) keep
  // resolving as noindex "no longer listed" leaves so links Google and readers
  // already hold don't 404. Retired slugs with a live successor become 301s in
  // astro.config.mjs instead and are not built here.
  const { orphans } = resolveRetired(retiredData, all, archived, todayPt);
  const retiredPages = orphans.map(({ slug, event, retiredAt }) => ({
    params: { slug },
    props: {
      event: event as RawEvent,
      passed: Boolean(event.date && event.date < todayPt),
      retired: true,
      updatedAt: retiredAt ?? null,
    },
  }));
  return [...livePages, ...retiredPages];
}

interface Props {
  event: RawEvent;
  passed: boolean;
  /** left the source feed before its date — rendered noindex with a notice */
  retired: boolean;
  updatedAt: string | null;
}

const { event, passed, retired, updatedAt } = Astro.props;
const cityName = event.city ? CITIES.find((c) => c.id === event.city)?.name ?? null : null;
const pageUrl = `https://southbaytoday.org${Astro.url.pathname}`;

// Online-only events still get a page — they're real, attendable things — but
// nothing on it may read as "go here." SJSU lists most of its campus feed with
// a San Jose State University venue whether or not the event is on Zoom, so a
// virtual event rendered the usual way ships a venue, a city, and a map link
// to a room that doesn't exist. Flag comes from the source's own location
// type at ingest (see eventFilters.mjs).
const isVirtual = isVirtualEvent(event);

const dayLabel = new Date(`${event.date}T12:00:00Z`).toLocaleDateString("en-US", {
  timeZone: "UTC",
  weekday: "long",
  month: "long",
  day: "numeric",
  year: "numeric",
});

const timeLabel = event.endTime && event.time ? `${event.time}–${event.endTime}` : event.time ?? "";
const metaBits = isVirtual
  ? [timeLabel, "Online", event.venue].filter(Boolean)
  : [timeLabel, event.venue, cityName].filter(Boolean);
// Same facts as metaBits, with the time pulled out so it can lead in bold.
const metaPlace = (isVirtual ? ["Online", event.venue] : [event.venue, cityName]).filter(Boolean);

// <title> uncapped ran long on most events — drop the year (redundant with the
// visible dayLabel elsewhere on the page) and, if it's still long, drop the
// site suffix rather than truncate the event's actual title.
const dayLabelNoYear = new Date(`${event.date}T12:00:00Z`).toLocaleDateString("en-US", {
  timeZone: "UTC",
  weekday: "long",
  month: "long",
  day: "numeric",
});
// Separate sessions often share a title and date (two comedy showtimes, two
// library appointments, or same-named events in different cities). Their
// stable slugs already differ; give their search-result titles the same
// distinction. Prefer time because it is reader-useful and unique for the
// current collision set, then fall back to venue or city when needed.
const titlePool = [
  ...((upcomingData as { events?: RawEvent[] }).events ?? []),
  ...((archiveData as { events?: RawEvent[] }).events ?? []),
];
const sameDayTitleEvents = titlePool.filter(
  (candidate) => candidate.date === event.date && candidate.title === event.title,
);
const uniqueTime = event.time && sameDayTitleEvents.filter((candidate) => candidate.time === event.time).length === 1
  ? event.time
  : null;
const uniqueVenue = event.venue && sameDayTitleEvents.filter((candidate) => candidate.venue === event.venue).length === 1
  ? event.venue
  : null;
const uniqueCity = cityName && sameDayTitleEvents.filter((candidate) => candidate.city === event.city).length === 1
  ? cityName
  : null;
const titleDisambiguator = sameDayTitleEvents.length > 1 ? uniqueTime || uniqueVenue || uniqueCity : null;
const titleCore = [event.title, titleDisambiguator, dayLabelNoYear].filter(Boolean).join(" — ");
const title = titleCore.length > 68 ? titleCore : `${titleCore} — South Bay Today`;

function capDescription(text: string, max = 155): string {
  const trimmed = text.trim();
  if (trimmed.length <= max) return trimmed;
  const sliced = trimmed.slice(0, max);
  const lastSpace = sliced.lastIndexOf(" ");
  const safe = (lastSpace > 0 ? sliced.slice(0, lastSpace) : sliced).trimEnd();
  return `${safe}…`;
}
const description = capDescription(
  isVirtual
    ? `${event.title} on ${dayLabel}. Online event${event.venue ? ` hosted by ${event.venue}` : ""}. ${(
        event.blurb || event.description || ""
      ).trim()}`.trim()
    : `${event.title} on ${dayLabel}${event.venue ? ` at ${event.venue}` : ""}${
        cityName ? ` in ${cityName}` : ""
      }. ${(event.blurb || event.description || "").trim()}`.trim(),
);

const directImageUrl = normalizeAbsoluteHttpUrl(event.image);
// photoRef resolves to a Google Places photo OF THE VENUE. For an online-only
// event that is a picture of a building the reader cannot go to — the same
// false-place claim as the map link, just in image form. The event's own art
// (event.image) is still fine; only the venue-photo fallback is suppressed.
const imageUrl = directImageUrl
  ? directImageUrl
  : event.photoRef && !isVirtual
    ? `/api/place-photo?ref=${encodeURIComponent(event.photoRef)}&w=760&h=420`
    : null;

const mapsQuery = [event.venue, event.address, cityName ? `${cityName}, CA` : null]
  .filter(Boolean)
  .join(", ");
const mapsUrl = !isVirtual && mapsQuery
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapsQuery)}`
  : null;

// Address strings pulled from source listings often repeat the venue name
// ("Frost Amphitheater, 327 Lasuen St, ..."). The "Where" line already shows
// the venue, so strip a leading venue prefix before rendering the address.
function stripVenuePrefix(address: string | null | undefined, venue: string | null | undefined): string {
  const addr = (address ?? "").trim();
  const v = (venue ?? "").trim();
  if (!addr || !v) return addr;
  const escaped = v.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const re = new RegExp(`^${escaped}\\s*,?\\s*`, "i");
  return addr.replace(re, "").trim();
}
const displayAddress = stripVenuePrefix(event.address, event.venue);

// Source addresses often already end in the city ("615 Cuesta Dr, Mountain
// View, CA 94040"), so appending the city label again read as
// "…CA 94040, Mountain View". Same intent as stripVenuePrefix above: the Where
// line states each fact once. Composed here rather than from adjacent JSX
// expressions, which inserted a stray space before the comma.
function addressNamesCity(address: string, city: string | null): boolean {
  if (!address || !city) return false;
  // Compare without diacritics: the feed writes "San Jose" in addresses while
  // the city label is "San José", and an accent is not a second location.
  const fold = (value: string) => value.normalize("NFD").replace(/\p{Diacritic}/gu, "");
  const escaped = fold(city).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  return new RegExp(`\\b${escaped}\\b`, "i").test(fold(address));
}
const whereLine = [
  event.venue,
  displayAddress ? ` — ${displayAddress}` : "",
  cityName && !addressNamesCity(displayAddress, cityName) ? `, ${cityName}` : "",
].join("");

const calendarUrl = buildGoogleCalendarUrl({
  title: event.title ?? "",
  date: event.date ?? "",
  time: event.time,
  endTime: event.endTime,
  venue: event.venue,
  address: event.address,
  city: event.city,
  description: event.description,
  blurb: event.blurb,
  url: event.url,
});

// Passed archive leaves stay crawlable for the ~30-day window but must not
// advertise EventScheduled — GSC flags stale Event objects on pages that
// already say the event happened. A retired leaf can't vouch for its facts
// either, so it ships no Event object.
const eventSchema = passed || retired
  ? null
  : eventToSchema({ ...event, virtual: isVirtual, cityName, pageUrl } as SchemaEventRecord);
const webPageSchema = {
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: title,
  inLanguage: "en-US",
  ...(updatedAt ? { dateModified: updatedAt } : {}),
  ...(eventSchema ? { mainEntity: { "@id": `${pageUrl}#event` } } : {}),
};
const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "South Bay Today", item: "https://southbaytoday.org" },
    { "@type": "ListItem", position: 2, name: "Events", item: "https://southbaytoday.org/events" },
    { "@type": "ListItem", position: 3, name: dayLabel, item: `https://southbaytoday.org/events/${event.date}` },
    { "@type": "ListItem", position: 4, name: event.title ?? "", item: pageUrl },
  ],
};
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": eventSchema ? [webPageSchema, eventSchema, breadcrumbSchema] : [webPageSchema, breadcrumbSchema],
});

const updatedLabel = updatedAt
  ? new Date(updatedAt).toLocaleString("en-US", {
      timeZone: "America/Los_Angeles",
      month: "short",
      day: "numeric",
      year: "numeric",
      hour: "numeric",
      minute: "2-digit",
      timeZoneName: "short",
    })
  : null;

// "More at {venue}" — other upcoming events at the same venue, case-insensitive
// match, soonest first, capped at 4. Self is excluded by date+title (same key
// getStaticPaths' dedup uses above), not just object identity, so this still
// holds if props ever stop being passed by reference.
const venueTodayPt = new Date().toLocaleDateString("en-CA", { timeZone: "America/Los_Angeles" });
const upcomingPool = ((upcomingData as { events?: RawEvent[] }).events ?? []).filter(
  (e) => e.date && e.date >= venueTodayPt && e.time,
);
const venueSlugs = buildEventSlugs(upcomingPool);
const slugByEvent = new Map<RawEvent, string>();
for (const [slug, e] of venueSlugs) slugByEvent.set(e, slug);
const eventVenueKey = (event.venue ?? "").trim().toLowerCase();
const isSelf = (e: RawEvent) => e === event || (e.date === event.date && e.title === event.title);
// "More at <venue>" is a place-based recommendation on both sides: it makes no
// sense for an online-only event, and an online-only sibling doesn't belong in
// a physical venue's list.
const moreAtVenue = eventVenueKey && !isVirtual
  ? upcomingPool
      .filter((e) => !isSelf(e) && !isVirtualEvent(e) && (e.venue ?? "").trim().toLowerCase() === eventVenueKey)
      .map((e) => ({ event: e, slug: slugByEvent.get(e) }))
      .filter((x): x is { event: RawEvent; slug: string } => Boolean(x.slug))
      .sort((a, b) => (a.event.date! < b.event.date! ? -1 : a.event.date! > b.event.date! ? 1 : 0))
      .slice(0, 4)
  : [];

const absoluteOgImage = imageUrl
  ? imageUrl.startsWith("http")
    ? imageUrl
    : `https://southbaytoday.org${imageUrl}`
  : undefined;

// Body copy: blurb leads; description follows only when it adds something new.
const blurb = (event.blurb ?? "").trim();
const longDesc = (event.description ?? "").trim();
const showDesc = longDesc && longDesc !== blurb && !blurb.startsWith(longDesc.slice(0, 40));
---

<CalendarShell title={title} description={description} ogImage={absoluteOgImage} activeTab="events" noindex={retired}>
  <Fragment slot="head">
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </Fragment>

  <nav class="cal-daynav evx-daynav" aria-label="Breadcrumb">
    {passed ? (
      <a class="evx-backlink" href="/events"><span aria-hidden="true">←</span> Upcoming events</a>
    ) : (
      <a class="evx-backlink" href={`/events/${event.date}`}><span aria-hidden="true">←</span> {dayLabel}</a>
    )}
    <span class="cal-kicker evx-kicker">South Bay / Event</span>
    <span class="evx-daynav-spacer" />
  </nav>

  {passed && (
    <p class="cal-passed">
      This event has passed — it happened {dayLabel}. <a href="/events">See what's coming up →</a>
    </p>
  )}
  {retired && !passed && (
    <p class="cal-passed">
      This listing is no longer on {event.source ? `the ${event.source} calendar` : "the organizer's calendar"} — it may
      have been cancelled, moved, or renamed. {event.url ? <>Check <a href={event.url} rel="noopener noreferrer">the source</a> before you go, or </>: <>Check with the organizer before you go, or </>}
      <a href={`/events/${event.date}`}>see what else is on {dayLabelNoYear} →</a>
    </p>
  )}

  <h1 class="evx-title">{event.title}</h1>
  <p class="cal-sub evx-meta">
    <span class="evx-meta-text">
      {timeLabel && <strong class="evx-meta-time">{timeLabel}</strong>}
      {timeLabel && metaPlace.length > 0 && <span class="evx-meta-sep" aria-hidden="true">·</span>}
      {metaPlace.join(" · ")}
    </span>
    {(isVirtual || event.cost === "free" || event.cost === "paid" || event.cost === "low" || event.kidFriendly) && (
      <span class="evx-chips">
        {isVirtual && <span class="cal-chip cal-chip--virtual evx-chip">Virtual</span>}
        {event.cost === "free" && <span class="cal-chip evx-chip">Free</span>}
        {event.cost === "paid" && <span class="cal-chip cal-chip--paid evx-chip">Paid</span>}
        {event.cost === "low" && <span class="cal-chip cal-chip--low evx-chip">Low cost</span>}
        {event.kidFriendly && <span class="cal-chip cal-chip--kids evx-chip">Kids</span>}
      </span>
    )}
  </p>

  {imageUrl && (
    <figure class="evx-photo">
      <img
        class="cal-detail-photo"
        src={imageUrl}
        width="760"
        height="420"
        alt={`${event.title}${event.venue ? (isVirtual ? ` — online, hosted by ${event.venue}` : ` at ${event.venue}`) : ""}`}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        onerror="this.closest('figure').hidden = true"
      />
    </figure>
  )}

  {blurb && <p class="cal-detail-copy">{blurb}</p>}
  {showDesc && <p class="cal-detail-copy cal-detail-copy--secondary">{longDesc}</p>}
  {event.attendanceNote && !longDesc.includes(event.attendanceNote) && (
    <p class="cal-detail-copy cal-detail-copy--secondary">{event.attendanceNote}</p>
  )}

  <dl class="cal-detail-facts">
    <div><dt>When</dt><dd>{dayLabel}{timeLabel && <> · <span class="evx-nowrap">{timeLabel}</span></>}</dd></div>
    {isVirtual ? (
      <div>
        <dt>Where</dt>
        <dd>
          Online{event.venue ? ` — hosted by ${event.venue}` : ""}. No in-person
          location; check the listing for the link.
        </dd>
      </div>
    ) : event.venue && (
      <div>
        <dt>Where</dt>
        <dd>
          {whereLine}
          {mapsUrl && (
            <>
              {" "}
              <a class="evx-map-link" href={mapsUrl} rel="noopener noreferrer">Map <span aria-hidden="true">↗</span></a>
            </>
          )}
        </dd>
      </div>
    )}
    {event.source && <div><dt>Listed by</dt><dd>{event.source}</dd></div>}
    {updatedAt && updatedLabel && (
      <div><dt>{retired ? "Last seen" : "Refreshed"}</dt><dd><time datetime={updatedAt}>{updatedLabel}</time></dd></div>
    )}
  </dl>

  <div class="cal-detail-actions">
    {event.url && (
      <a class="sb-btn sb-btn--primary" href={event.url} rel="noopener noreferrer" data-analytics-event="Event source click">
        Event details <span aria-hidden="true">↗</span>
      </a>
    )}
    {!passed && !retired && calendarUrl && (
      <a class="sb-btn" href={calendarUrl} rel="noopener noreferrer" data-analytics-event="Calendar add">
        Add to Google Calendar
      </a>
    )}
    {passed ? (
      <a class="sb-btn" href="/events" data-analytics-event="Related events click">Upcoming events</a>
    ) : (
      <a class="sb-btn" href={`/events/${event.date}`} data-analytics-event="Related events click">More events this day</a>
    )}
  </div>

  {moreAtVenue.length > 0 && (
    <section class="cal-more-venue" aria-labelledby="more-at-venue">
      <h2 class="cal-more-venue-heading" id="more-at-venue">More at {event.venue}</h2>
      <ul class="evx-more-list">
        {moreAtVenue.map(({ event: e, slug }) => (
          <li>
            <a class="evx-more-row" href={`/event/${slug}`} data-analytics-event="More at venue click">
              <span class="evx-more-date">
                {new Date(`${e.date}T12:00:00Z`).toLocaleDateString("en-US", {
                  timeZone: "UTC",
                  month: "short",
                  day: "numeric",
                })}
              </span>
              <span class="evx-more-title">{e.title}</span>
              <span class="evx-more-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</CalendarShell>

<script>
  import { track } from "@vercel/analytics";

  document.querySelectorAll<HTMLElement>("[data-analytics-event]").forEach((element) => {
    element.addEventListener("click", () => {
      const eventName = element.dataset.analyticsEvent;
      if (eventName) track(eventName);
    });
  });
</script>

<style>
  /* Page-only polish for the event detail leaf; the shared .cal-* base lives
     in CalendarShell. evx-* = event detail. */

  /* Breadcrumb row */
  /* Three columns so the kicker sits dead center whatever the link width. */
  .evx-daynav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    margin-bottom: 22px;
  }
  .evx-daynav > :first-child {
    justify-self: start;
  }
  .evx-daynav .evx-backlink {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    max-width: 100%;
    padding: 6px 14px;
    border: 1px solid var(--sb-line-strong);
    border-radius: var(--sb-radius-pill);
    background: rgba(255, 255, 255, 0.8);
    color: var(--sb-ink-2);
    font-family: var(--sb-mono);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .evx-daynav .evx-backlink:hover {
    border-color: var(--sb-ink);
    background: var(--sb-ink);
    color: #fff;
    text-decoration: none;
  }
  .evx-daynav-spacer {
    min-width: 1px;
  }

  /* Title block */
  .evx-title {
    margin-bottom: 12px;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .evx-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-bottom: 26px;
    padding-bottom: 22px;
    font-size: 16px;
    line-height: 1.5;
  }
  .evx-meta-time {
    color: var(--sb-ink);
    font-weight: 700;
    white-space: nowrap;
  }
  .evx-meta-sep {
    color: var(--sb-light);
  }
  .evx-chips {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .evx-chips .evx-chip {
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 3px 9px;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    line-height: 14px;
    vertical-align: baseline;
  }
  .cal-chip--paid {
    border-color: #ddd6fe;
    background: #f5f3ff;
    color: #5b21b6;
  }
  .cal-chip--low {
    border-color: #fed7aa;
    background: #fff7ed;
    color: #9a3412;
  }

  /* Photo: warm placeholder while it loads; hidden entirely if it 404s. */
  .evx-photo {
    margin: 0 0 24px;
    overflow: hidden;
    border: 1px solid var(--sb-line);
    border-radius: var(--sb-radius-md);
    background: var(--sb-arc-soft);
    box-shadow: var(--sb-shadow-sm);
  }
  .evx-photo[hidden] {
    display: none;
  }
  .evx-photo .cal-detail-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 760 / 420;
    max-height: 440px;
    object-fit: cover;
  }

  /* Copy */
  .cal-detail-copy {
    max-width: 64ch;
    margin: 0 0 14px;
    color: var(--sb-ink);
    font-size: 17px;
    line-height: 1.65;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  .cal-detail-copy--secondary {
    color: var(--sb-muted);
    font-size: 15px;
    line-height: 1.6;
  }

  /* Facts card: When / Where / Listed by / Refreshed */
  .cal-detail-facts {
    margin: 28px 0 0;
    padding: 4px 20px;
    background: var(--sb-card);
    border: 1px solid var(--sb-line);
    border-radius: var(--sb-radius-md);
    box-shadow: var(--sb-shadow-sm);
  }
  .cal-detail-facts > div {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr);
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--sb-line);
  }
  .cal-detail-facts > div:last-child {
    border-bottom: 0;
  }
  .cal-detail-facts dt {
    padding-top: 4px;
    color: var(--sb-muted);
    font-family: var(--sb-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
