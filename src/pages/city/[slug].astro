---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CityPage from "../../components/south-bay/city/CityPage.tsx";
import StaticLinkStrip from "../../components/south-bay/StaticLinkStrip.astro";
import { CITIES } from "../../lib/south-bay/cities";
import { getCityPageData } from "../../lib/south-bay/cityPageData";
import upcomingData from "../../data/south-bay/upcoming-events.json";
import { eventListJsonLd, type SchemaEventRecord } from "../../lib/south-bay/eventSchema";
import { buildEventSlugs } from "../../lib/south-bay/eventSlug";

export function getStaticPaths() {
  return CITIES.map((city) => ({
    params: { slug: city.id },
    props: { cityId: city.id, cityName: city.name },
  }));
}

const { cityId, cityName } = Astro.props;
const title = `${cityName} — South Bay Today`;
const description = `What's happening in ${cityName} today: events, city council meetings, development updates, and local news.`;
// This city's slice of the meetings, digests, Reddit, and camps data.
// CityPage is a client:load island, so importing the all-city files there
// would ship every city's data to every city page. (Its Open Right Now pool
// comes from ./[slug]/open-now.json.ts instead.)
const cityData = getCityPageData(cityId, cityName);
// santa-cruz has no dedicated OG card — cities.ts marks it a case-by-case
// pick, not full coverage (scripts/generate-og-images.mjs skips it too), so
// it falls back to BaseLayout's shared default image.
const absoluteOgImage =
  cityId !== "santa-cruz" ? `https://southbaytoday.org/og/og-city-${cityId}.jpg` : undefined;

// Build-time JSON-LD block (next 7 days of the city's events). CityPage
// server-renders its chrome now, but its events list still arrives via a
// client fetch — this structured data is what crawlers index for events.
// todayPt is also the island's build day: CityPage hydrates against it, then
// switches to the reader's day (see useTodayPT).
const todayPt = new Date().toLocaleDateString("en-CA", { timeZone: "America/Los_Angeles" });
const weekOut = new Date();
weekOut.setDate(weekOut.getDate() + 7);
const weekOutPt = weekOut.toLocaleDateString("en-CA", { timeZone: "America/Los_Angeles" });
const allEvents = ((upcomingData as { events?: SchemaEventRecord[] }).events ?? []);
const slugById = new Map<string, string>();
for (const [slug, event] of buildEventSlugs(allEvents)) {
  if (event.id) slugById.set(String(event.id), slug);
}
const cityEvents = allEvents
  .filter((e) => e.city === cityId && e.time && e.date && e.date >= todayPt && e.date <= weekOutPt)
  .map((e) => {
    const slug = e.id ? slugById.get(String(e.id)) ?? null : null;
    return {
      ...e,
      cityName,
      pageUrl: slug ? `https://southbaytoday.org/event/${slug}` : null,
    };
  });
const jsonLd = eventListJsonLd(cityEvents, {
  name: `Events in ${cityName} this week`,
  url: `https://southbaytoday.org/city/${cityId}`,
  limit: 25,
});
---

<BaseLayout
  title={title}
  description={description}
  themeColor="#FFF8F2"
  ogImage={absoluteOgImage}
>
  <Fragment slot="head">
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </Fragment>

  <CityPage cityId={cityId} cityName={cityName} data={cityData} buildDayPt={todayPt} client:load />
  <StaticLinkStrip days govCities />
</BaseLayout>
