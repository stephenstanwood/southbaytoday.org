---
// Custom 404 — Astro/Vercel serve this automatically for unmatched routes on
// static output. On-brand instead of the stock framework error page.
import CalendarShell from "../layouts/CalendarShell.astro";

const title = "Page not found — South Bay Today";
const description = "This page isn't on the calendar. Find today's plan, upcoming events, or a South Bay city page instead.";
---

<CalendarShell title={title} description={description}>
  <script is:inline>
    // The Astro analytics component stamps the build-time pathname, so every
    // missing URL reaches Vercel Web Analytics as one "/404" page row and the
    // actual broken links are invisible there. Send the real URL instead; the
    // route stays "/404", so the Routes view still totals them on one line.
    // BaseLayout's notrack opt-out runs later in the body and still wins.
    window.webAnalyticsBeforeSend = (event) => ({ ...event, url: location.href });
  </script>
  <nav class="cal-daynav" aria-label="Breadcrumb">
    <a href="/">← Home</a>
    <span class="cal-kicker">South Bay / 404</span>
    <span />
  </nav>

  <h1>This page isn't on the calendar.</h1>
  <p class="cal-sub">
    The link's broken or the page moved. Here's where things actually are.
  </p>

  <ul class="nf-links">
    <li>
      <a href="/" class="nf-link">
        <span class="nf-link-title">Today's plan</span>
        <span class="nf-link-desc">What's happening across the South Bay right now.</span>
        <span class="nf-link-arrow" aria-hidden="true">→</span>
      </a>
    </li>
    <li>
      <a href="/events" class="nf-link">
        <span class="nf-link-title">Events</span>
        <span class="nf-link-desc">Everything coming up, filterable by city.</span>
        <span class="nf-link-arrow" aria-hidden="true">→</span>
      </a>
    </li>
    <li>
      <a href="/city/san-jose" class="nf-link">
        <span class="nf-link-title">San José</span>
        <span class="nf-link-desc">One city's events, council, and news in one place.</span>
        <span class="nf-link-arrow" aria-hidden="true">→</span>
      </a>
    </li>
  </ul>
</CalendarShell>

<style>
  /* Where-to-go-instead list: each destination is one tappable card. */
  .nf-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 620px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nf-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "title arrow"
      "desc arrow";
    align-items: center;
    gap: 4px 16px;
    padding: 18px 22px;
    border: 1px solid var(--sb-line);
    border-radius: var(--sb-radius-md);
    background: var(--sb-card);
    box-shadow: var(--sb-shadow-sm);
    color: var(--sb-ink);
    text-decoration: none;
    transition: transform 0.25s var(--sb-ease), box-shadow 0.25s var(--sb-ease), border-color 0.2s;
  }
  .nf-link:hover {
    transform: translateY(-2px);
    border-color: var(--sb-line-strong);
    box-shadow: var(--sb-shadow-hover);
  }
  .nf-link-title {
    grid-area: title;
    font-family: var(--sb-serif);
    font-size: 21px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.005em;
  }
  .nf-link-desc {
    grid-area: desc;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--sb-muted);
    text-wrap: pretty;
  }
  .nf-link-arrow {
    grid-area: arrow;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1.5px solid var(--sb-line-strong);
    border-radius: 50%;
    font-size: 17px;
    font-weight: 700;
    color: var(--sb-ink);
    transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.25s var(--sb-ease);
  }
  .nf-link:hover .nf-link-arrow {
    border-color: var(--sb-ink);
    background: var(--sb-ink);
    color: #fff;
    transform: translateX(2px);
  }
  @media (max-width: 540px) {
    .nf-link {
      padding: 16px 16px 16px 18px;
    }
    .nf-link-title {
      font-size: 19px;
    }
    .nf-link-arrow {
      width: 36px;
      height: 36px;
    }
  }
</style>
