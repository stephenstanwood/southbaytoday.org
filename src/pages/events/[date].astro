---
// Static per-date event listings — the crawlable layer for the events data.
// The interactive Events tab is a client:only React app, so these pages are
// what search engines (and no-JS readers) actually see. Pure Astro, no
// hydration; regenerated on every nightly data build.
import CalendarShell from "../../layouts/CalendarShell.astro";
import upcomingData from "../../data/south-bay/upcoming-events.json";
import archiveData from "../../data/south-bay/events-archive.json";
import { CITIES } from "../../lib/south-bay/cities";
import { parseClockTime } from "../../lib/south-bay/calendarLink";
import { buildEventSlugs } from "../../lib/south-bay/eventSlug";
import { eventListJsonLd, type SchemaEventRecord } from "../../lib/south-bay/eventSchema";
import { isVirtualEvent } from "../../lib/south-bay/eventFilters.mjs";

// This file compiles to a component named `Date` (from the [date] param),
// shadowing the global Date constructor in the language server's view of the
// module. Alias the real constructor so date math typechecks.
const DateCtor = globalThis.Date;

interface RawEvent {
  id?: string | null;
  title?: string | null;
  date?: string | null;
  time?: string | null;
  endTime?: string | null;
  venue?: string | null;
  address?: string | null;
  city?: string | null;
  url?: string | null;
  image?: string | null;
  photoRef?: string | null;
  blurb?: string | null;
  description?: string | null;
  cost?: string | null;
  kidFriendly?: boolean | null;
  category?: string | null;
  virtual?: boolean | null;
}

export function getStaticPaths() {
  const DateCtor = globalThis.Date; // see module-level alias note
  const cityNames = new Map<string, string>(CITIES.map((c) => [c.id, c.name]));
  const all = (upcomingData as { events?: RawEvent[] }).events ?? [];
  const archived = (archiveData as { events?: RawEvent[] }).events ?? [];
  const todayPt = new DateCtor().toLocaleDateString("en-CA", { timeZone: "America/Los_Angeles" });
  const isDated = (e: RawEvent) => Boolean(e?.date && /^\d{4}-\d{2}-\d{2}$/.test(e.date));

  // Same pool as /event/[slug]: upcoming timed events plus passed ones from
  // the archive (90 days), so a passed day keeps resolving with a "this day
  // has passed" banner instead of 404ing the next morning. Search engines,
  // RSS readers, and IndexNow-fed indexes hold /events/<date> links well past
  // the date — before this grace window, /404 was the most-viewed page on the
  // site in Vercel analytics. Upcoming wins when a recurring event appears in
  // both pools. Exhibits / no-time records stay off date listings.
  const upcoming = all.filter((e) => isDated(e) && (e.date as string) >= todayPt && e.time);
  const past = archived.filter((e) => isDated(e) && (e.date as string) < todayPt && e.time);
  const seen = new Set(upcoming.map((e) => `${e.date}|${e.title}`));
  const pool = [...upcoming, ...past.filter((e) => !seen.has(`${e.date}|${e.title}`))];

  // Reverse lookup id → detail slug so listing links match /event/[slug].
  const slugById = new Map<string, string>();
  for (const [slug, e] of buildEventSlugs(pool)) {
    if (e.id) slugById.set(String(e.id), slug);
  }

  // A listing page for EVERY date with a timed event in the pool — no forward
  // window. /event/[slug] pages exist for all of them and each links back to
  // /events/<its date> (as do RSS, the breadcrumb JSON-LD, and the
  // StaticLinkStrip), so a date page has to exist wherever an event does or
  // that link 404s. The old 60-day cap left every event further out — 122 of
  // 183 future dates at last count — pointing at a page that was never built.
  const byDate = new Map<string, RawEvent[]>();
  for (const e of pool) {
    const date = e.date as string;
    if (!byDate.has(date)) byDate.set(date, []);
    byDate.get(date)!.push(e);
  }

  const dates = [...byDate.keys()].sort();
  return dates.map((date, i) => {
    const events = byDate
      .get(date)!
      .slice()
      .sort((a, b) => {
        const ta = parseClockTime(a.time);
        const tb = parseClockTime(b.time);
        return (ta ? ta.h * 60 + ta.m : 1441) - (tb ? tb.h * 60 + tb.m : 1441);
      })
      .map((e) => {
        const t = parseClockTime(e.time);
        return {
          ...e,
          cityName: e.city ? cityNames.get(e.city) ?? null : null,
          detailSlug: e.id ? slugById.get(String(e.id)) ?? null : null,
          // Minutes-since-midnight start time, used client-side to dim
          // already-started events when this date happens to be "today" in
          // the visitor's Pacific-time clock (the page itself is static and
          // can't know "now" at build time).
          startMinutes: t ? t.h * 60 + t.m : null,
        };
      });
    return {
      params: { date },
      props: {
        date,
        events,
        passed: date < todayPt,
        prevDate: i > 0 ? dates[i - 1] : null,
        nextDate: i < dates.length - 1 ? dates[i + 1] : null,
      },
    };
  });
}

interface Props {
  date: string;
  events: (RawEvent & { cityName: string | null; detailSlug: string | null; startMinutes: number | null })[];
  passed: boolean;
  prevDate: string | null;
  nextDate: string | null;
}

const { date, events, passed, prevDate, nextDate } = Astro.props;

const dayLabel = new DateCtor(`${date}T12:00:00Z`).toLocaleDateString("en-US", {
  timeZone: "UTC",
  weekday: "long",
  month: "long",
  day: "numeric",
  year: "numeric",
});
const shortLabel = (d: string) =>
  new DateCtor(`${d}T12:00:00Z`).toLocaleDateString("en-US", { timeZone: "UTC", weekday: "short", month: "short", day: "numeric" });

const cityCount = new Set(events.map((e) => e.city).filter(Boolean)).size;

// Time column: "8:00 AM" → "8:00" + a quieter "AM". Anything that isn't a
// plain clock time (ranges, "Noon") renders as-is.
function splitClock(time: string | null | undefined): { clock: string; period: string | null } {
  const raw = (time ?? "").trim();
  const m = raw.match(/^(\d{1,2})(?::(\d{2}))?\s*([ap])\.?m\.?$/i);
  if (!m) return { clock: raw, period: null };
  return { clock: `${Number(m[1])}:${m[2] ?? "00"}`, period: `${m[3].toUpperCase()}M` };
}
const title = `Events on ${dayLabel} — South Bay Today`;
const description = `${events.length} things ${passed ? "that happened" : "happening"} across the South Bay on ${dayLabel}: ${events
  .slice(0, 3)
  .map((e) => e.title)
  .filter(Boolean)
  .join(", ")}, and more.`;

// Passed days stay crawlable for the archive window but must not advertise
// EventScheduled — GSC flags stale Event objects on pages that already say
// the day has passed (same rule as /event/[slug]).
const listJsonLd = passed ? null : eventListJsonLd(events.map((event) => ({
  ...event,
  pageUrl: event.detailSlug ? `https://southbaytoday.org/event/${event.detailSlug}` : null,
})) as SchemaEventRecord[], {
  name: `South Bay events on ${dayLabel}`,
  url: `https://southbaytoday.org/events/${date}`,
  limit: 60,
});
const breadcrumbJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "South Bay Today", item: "https://southbaytoday.org" },
    { "@type": "ListItem", position: 2, name: "Events", item: "https://southbaytoday.org/events" },
    { "@type": "ListItem", position: 3, name: dayLabel },
  ],
});
---

<CalendarShell title={title} description={description} activeTab="events">
  <Fragment slot="head">
    {listJsonLd && <script type="application/ld+json" set:html={listJsonLd} />}
    <script type="application/ld+json" set:html={breadcrumbJsonLd} />
  </Fragment>

  <nav class="cal-daynav evd-daynav" aria-label="Browse days">
    {prevDate ? (
      <a class="evd-daylink" href={`/events/${prevDate}`} rel="prev">
        <span aria-hidden="true">←</span> {shortLabel(prevDate)}
      </a>
    ) : <span />}
    <span class="cal-kicker evd-kicker">South Bay / Calendar</span>
    {nextDate ? (
      <a class="evd-daylink evd-daylink--next" href={`/events/${nextDate}`} rel="next">
        {shortLabel(nextDate)} <span aria-hidden="true">→</span>
      </a>
    ) : <span />}
  </nav>

  {passed && (
    <p class="cal-passed">
      This day has passed — these events already happened. <a href="/events">See what's coming up →</a>
    </p>
  )}

  <h1 class="evd-title">{dayLabel}</h1>
  <p class="cal-sub evd-sub">
    <strong>{events.length} {events.length === 1 ? "event" : "events"}</strong> across {cityCount}{" "}
    {cityCount === 1 ? "city" : "South Bay cities"}
    <span class="evd-sub-sep" aria-hidden="true">·</span>
    <a class="evd-sub-link" href="/events">search &amp; filter on the Events tab →</a>
  </p>

  <ol class="cal-list evd-list">
    {events.map((e) => {
      const { clock, period } = splitClock(e.time);
      return (
        <li class="cal-event evd-row" data-start-min={e.startMinutes ?? ""}>
          <div class="cal-time evd-time">
            {clock}{period && <span class="evd-time-period"> {period}</span>}
          </div>
          <div class="cal-body evd-body">
            <h2>
              {e.detailSlug ? (
                <a href={`/event/${e.detailSlug}`}>{e.title}</a>
              ) : e.url ? (
                <a href={e.url} rel="noopener noreferrer">{e.title}</a>
              ) : (
                e.title
              )}
            </h2>
            <p class="cal-meta evd-meta">
              <span class="evd-where">
                {isVirtualEvent(e)
                  ? ["Online", e.venue].filter(Boolean).join(" · ")
                  : [e.venue, e.cityName].filter(Boolean).join(" · ")}
              </span>
              {isVirtualEvent(e) && <span class="cal-chip cal-chip--virtual evd-chip">Virtual</span>}
              {e.cost === "free" && <span class="cal-chip evd-chip">Free</span>}
              {e.kidFriendly && <span class="cal-chip cal-chip--kids evd-chip">Kids</span>}
            </p>
            {(e.blurb || e.description) && <p class="cal-copy evd-copy">{e.blurb || e.description}</p>}
          </div>
        </li>
      );
    })}
  </ol>

  <script define:vars={{ pageDate: date }}>
    // This page is static (build-time rendered), so it can't know "now" —
    // only the visitor's browser can. When the page's date matches today in
    // Pacific time, dim any event whose start time has already passed and
    // label it, instead of silently listing it alongside events still ahead.
    const todayPt = new Date().toLocaleDateString("en-CA", { timeZone: "America/Los_Angeles" });
    if (pageDate === todayPt) {
      const now = new Date();
      const nowPt = new Date(now.toLocaleString("en-US", { timeZone: "America/Los_Angeles" }));
      const nowMinutes = nowPt.getHours() * 60 + nowPt.getMinutes();
      document.querySelectorAll(".cal-event[data-start-min]").forEach((el) => {
        const raw = el.getAttribute("data-start-min");
        if (!raw) return;
        const startMinutes = Number(raw);
        if (!Number.isFinite(startMinutes) || startMinutes > nowMinutes) return;
        el.classList.add("cal-event--started");
        const meta = el.querySelector(".cal-meta");
        if (meta && !meta.querySelector(".cal-chip--started")) {
          const badge = document.createElement("span");
          badge.className = "cal-chip evd-chip cal-chip--started";
          badge.textContent = "Already started";
          meta.appendChild(badge);
        }
      });
    }
  </script>

  <style>
    /* Page-only polish for the static day listing; the shared .cal-* base
       lives in CalendarShell. evd-* = events-day. */

    /* Day nav: prev/next as quiet pills around the kicker. */
    /* Three columns so the kicker sits dead center whatever the link widths. */
    .evd-daynav {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      margin-bottom: 22px;
    }
    .evd-daynav > :first-child {
      justify-self: start;
    }
    .evd-daynav > :last-child {
      justify-self: end;
    }
    .evd-daynav .evd-daylink {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-height: 36px;
      padding: 6px 14px;
      border: 1px solid var(--sb-line-strong);
      border-radius: var(--sb-radius-pill);
      background: rgba(255, 255, 255, 0.8);
      color: var(--sb-ink-2);
      font-family: var(--sb-mono);
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-decoration: none;
      white-space: nowrap;
      transition: background 0.15s, border-color 0.15s, color 0.15s;
    }
    .evd-daynav .evd-daylink:hover {
      border-color: var(--sb-ink);
      background: var(--sb-ink);
      color: #fff;
      text-decoration: none;
    }
    .evd-kicker {
      text-align: center;
    }

    .evd-title {
      margin-bottom: 12px;
    }
    .evd-sub {
      margin-bottom: 8px;
      padding-bottom: 22px;
      text-wrap: pretty;
    }
    .evd-sub strong {
      color: var(--sb-ink);
      font-weight: 700;
    }
    .evd-sub-sep {
      margin: 0 3px;
      color: var(--sb-light);
    }
    .evd-sub .evd-sub-link {
      color: var(--sb-accent-ink);
      font-weight: 600;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-decoration-color: rgba(109, 40, 217, 0.35);
      text-underline-offset: 3px;
    }
    .evd-sub .evd-sub-link:hover {
      text-decoration-color: currentColor;
    }

    /* The list: time column + body, hairline rhythm. */
    .evd-row {
      grid-template-columns: 88px minmax(0, 1fr);
      gap: 20px;
      padding: 20px 0 21px;
    }
    .evd-row:first-child {
      padding-top: 12px;
    }
    .evd-time {
      padding-top: 5px;
      color: var(--sb-ink);
      font-size: 13px;
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.01em;
    }
    .evd-time-period {
      color: var(--sb-muted);
      font-size: 10.5px;
      letter-spacing: 0.08em;
    }
    .evd-body h2 {
      font-size: 20.5px;
      line-height: 1.22;
      margin-bottom: 6px;
      text-wrap: balance;
      overflow-wrap: anywhere;
    }
    .evd-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px 8px;
      font-size: 13.5px;
      line-height: 1.45;
    }
    .evd-where {
      margin-right: 2px;
    }
    .evd-meta .evd-chip {
      display: inline-flex;
      align-items: center;
      margin: 0;
      padding: 2px 8px;
      font-size: 10.5px;
      letter-spacing: 0.08em;
      line-height: 14px;
      vertical-align: baseline;
    }
    .evd-copy {
      margin-top: 8px;
      font-size: 14.5px;
      line-height: 1.6;
      max-width: 64ch;
      text-wrap: pretty;
    }

    .cal-passed {
      margin: 0 0 18px;
      padding: 12px 16px;
      border: 1px solid #fde68a;
      background: #fffbeb;
      color: #92400e;
      border-radius: var(--sb-radius-sm);
      font-size: 14px;
      line-height: 1.5;
    }
    .cal-passed a {
      color: inherit;
      font-weight: 700;
      text-underline-offset: 3px;
    }
    .cal-event--started {
      opacity: 0.55;
    }
    /* Added by the inline script, so it carries no scoped attribute. */
    :global(.cal-chip.cal-chip--started) {
      border-color: var(--sb-line-strong);
      background: transparent;
      color: var(--sb-muted);
    }

    @media (max-width: 540px) {
      .evd-daynav {
        grid-template-columns: auto auto;
        grid-template-areas: "kicker kicker" "prev next";
        row-gap: 12px;
        margin-bottom: 18px;
      }
      .evd-daynav > :first-child {
        grid-area: prev;
      }
      .evd-daynav > :last-child {
        grid-area: next;
      }
      .evd-daynav .evd-kicker {
        grid-area: kicker;
        text-align: left;
      }
      .evd-daynav .evd-daylink {
        min-height: 40px;
      }
      .evd-row {
        grid-template-columns: 1fr;
        gap: 6px;
        padding: 18px 0 19px;
      }
      .evd-time {
        padding-top: 0;
        color: var(--sb-accent-ink);
        font-size: 12.5px;
      }
      .evd-time-period {
        color: var(--sb-accent-ink);
        opacity: 0.75;
      }
      .evd-body h2 {
        font-size: 19px;
      }
      .evd-copy {
        font-size: 14px;
      }
    }
  </style>
</CalendarShell>
