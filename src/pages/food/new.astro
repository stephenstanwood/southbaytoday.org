---
// Static food-business updates page — the crawlable surface for verified
// openings, SCC final inspections, and coming-soon records.
// The Food tab renders the same data interactively; this page is pure HTML,
// month-stamped, regenerated nightly.
import CalendarShell from "../../layouts/CalendarShell.astro";
import openingsJson from "../../data/south-bay/scc-food-openings.json";
import { CITY_MAP } from "../../lib/south-bay/cities";

interface Opening {
  id: string;
  name: string;
  address?: string | null;
  cityId?: string | null;
  cityName?: string | null;
  date?: string | null;
  inspectionDate?: string | null;
  blurb?: string | null;
}

const data = openingsJson as { generatedAt?: string; opened?: Opening[]; inspections?: Opening[]; comingSoon?: Opening[] };
const opened = data.opened ?? [];
const inspections = data.inspections ?? [];
const comingSoon = data.comingSoon ?? [];

const monthLabel = new Date().toLocaleDateString("en-US", {
  timeZone: "America/Los_Angeles",
  month: "long",
  year: "numeric",
});

const title = `South Bay food openings and permits (${monthLabel}) — South Bay Today`;
const description = `${opened.length} verified openings, ${inspections.length} recent final inspections, and ${comingSoon.length} coming-soon food businesses across the South Bay.`;

// The county dataset ships cityName in caps ("SAN JOSE"). Prefer the canonical
// registry name via cityId so this page says "San José" like the rest of the
// site; plain title-casing the raw string drops the accent.
const tidyCity = (s?: string | null, cityId?: string | null) =>
  (cityId && CITY_MAP[cityId as keyof typeof CITY_MAP]?.name) ||
  (s ?? "")
    .toLowerCase()
    .replace(/\b[a-z]/g, (c) => c.toUpperCase());

// "2026-09-18" → { mo: "Sep", day: "18" } for the date stamp.
const dateParts = (d?: string | null) => {
  if (!d || !/^\d{4}-\d{2}-\d{2}$/.test(d)) return null;
  const at = new Date(`${d}T12:00:00Z`);
  return {
    mo: at.toLocaleDateString("en-US", { timeZone: "UTC", month: "short" }),
    day: at.toLocaleDateString("en-US", { timeZone: "UTC", day: "numeric" }),
  };
};

// NBSP before each "·" so a wrapped meta line never starts with a separator.
const meta = (r: Opening) =>
  [r.address, tidyCity(r.cityName, r.cityId)].filter(Boolean).join("\u00a0· ");

const groups = [
  { id: "opened", tone: "open", heading: "Verified openings", rows: opened, dateOf: (r: Opening) => r.date },
  { id: "inspections", tone: "inspection", heading: "Recent final inspections", rows: inspections, dateOf: (r: Opening) => r.inspectionDate },
  { id: "coming-soon", tone: "soon", heading: "Coming soon", rows: comingSoon, dateOf: (r: Opening) => r.date },
].filter((g) => g.rows.length > 0);

const breadcrumbJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "South Bay Today", item: "https://southbaytoday.org" },
    { "@type": "ListItem", position: 2, name: "Food", item: "https://southbaytoday.org/food" },
    { "@type": "ListItem", position: 3, name: "New & coming soon" },
  ],
});
---

<CalendarShell title={title} description={description} activeTab="food">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={breadcrumbJsonLd} />
  </Fragment>

  <nav class="cal-daynav" aria-label="Breadcrumb">
    <a href="/food">← Food desk</a>
    <span class="cal-kicker">South Bay / Food</span>
    <span />
  </nav>

  <h1>South Bay food openings and permits</h1>
  <p class="cal-sub fn-sub">
    <strong>{opened.length}</strong>&nbsp;verified openings · <strong>{inspections.length}</strong>&nbsp;final inspections · <strong>{comingSoon.length}</strong>&nbsp;coming soon · refreshed daily ·{" "}
    <a href="/food">browse the Food desk&nbsp;→</a>
  </p>

  {groups.map((g) => (
    <section class={`fn-group fn-tone--${g.tone}`} aria-labelledby={`fn-${g.id}`}>
      <h2 class="fn-section" id={`fn-${g.id}`}>
        <span class="fn-dot" aria-hidden="true"></span>
        {g.heading}
        <span class="fn-count">{g.rows.length}</span>
      </h2>
      <ol class="cal-list">
        {g.rows.map((r) => {
          const when = dateParts(g.dateOf(r));
          return (
            <li class="cal-event fn-item">
              <div class="cal-time fn-when">
                {when ? (
                  <span class="fn-stamp">
                    <span class="fn-stamp-mo">{when.mo}</span>
                    <span class="fn-stamp-day">{when.day}</span>
                  </span>
                ) : (
                  <span class="fn-stamp fn-stamp--none">—</span>
                )}
              </div>
              <div class="cal-body">
                <h3 class="fn-name">{r.name}</h3>
                <p class="cal-meta">{meta(r)}</p>
                {r.blurb && <p class="cal-copy">{r.blurb}</p>}
              </div>
            </li>
          );
        })}
      </ol>
    </section>
  ))}

  {groups.length === 0 && (
    <p class="fn-empty">No new food permits on file right now. The county list refreshes nightly, so check back soon.</p>
  )}

  <p class="fn-note">
    Final-inspection dates come from the county's environmental-health records and are not
    opening dates. An item is labeled opened only when a separate source establishes the
    date. Coming-soon dates are permit dates. Spot something wrong? Use the Tips &amp; Feedback button on the
    <a href="/food">Food desk</a>.
  </p>
</CalendarShell>

<style>
  .fn-sub strong {
    color: var(--sb-ink);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .fn-sub a {
    white-space: nowrap;
  }

  .fn-group {
    --fn-tone: var(--sb-muted);
  }
  .fn-tone--open { --fn-tone: #15803d; }
  .fn-tone--inspection { --fn-tone: var(--sb-accent); }
  .fn-tone--soon { --fn-tone: #0e7490; }

  .fn-group + .fn-group {
    margin-top: 40px;
  }

  .fn-section {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--sb-line-strong);
    color: var(--sb-ink);
    font-family: var(--sb-serif);
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .fn-dot {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--fn-tone);
  }

  .fn-count {
    margin-left: auto;
    padding: 4px 9px;
    border: 1px solid var(--sb-line);
    border-radius: var(--sb-radius-pill);
    background: var(--sb-card);
    color: var(--sb-muted);
    font-family: var(--sb-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
  }

  .fn-item {
    grid-template-columns: 76px minmax(0, 1fr);
    align-items: start;
  }

  .fn-when {
    padding-top: 0;
  }

  /* Tear-off calendar stamp: mono month over a serif day. */
  .fn-stamp {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    min-width: 54px;
    padding: 6px 8px 7px;
    border: 1px solid var(--sb-line);
    border-top: 3px solid var(--fn-tone);
    border-radius: var(--sb-radius-sm);
    background: var(--sb-card);
    box-shadow: var(--sb-shadow-xs);
  }

  .fn-stamp-mo {
    color: var(--sb-muted);
    font-family: var(--sb-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .fn-stamp-day {
    color: var(--sb-ink);
    font-family: var(--sb-serif);
    font-size: 24px;
    font-weight: 900;
    line-height: 1.05;
    font-variant-numeric: lining-nums;
  }

  .fn-stamp--none {
    justify-content: center;
    min-height: 52px;
    color: var(--sb-light);
    font-family: var(--sb-sans);
  }

  .fn-name {
    margin: 2px 0 5px;
    color: var(--sb-ink);
    font-family: var(--sb-serif);
    font-size: 19px;
    font-weight: 800;
    line-height: 1.25;
    text-wrap: balance;
  }

  .fn-item :global(.cal-meta) {
    font-size: 13.5px;
    line-height: 1.5;
  }

  .fn-empty {
    margin: 8px 0 0;
    padding: 28px 20px;
    border: 1px dashed var(--sb-line-strong);
    border-radius: var(--sb-radius-md);
    color: var(--sb-muted);
    font-size: 15px;
    text-align: center;
  }

  .fn-note {
    margin: 36px 0 0;
    padding: 14px 16px;
    border: 1px solid var(--sb-line);
    border-radius: var(--sb-radius-md);
    background: rgba(255, 255, 255, 0.6);
    color: var(--sb-muted);
    font-size: 13px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .fn-note a {
    color: var(--sb-ink-2);
    font-weight: 600;
    text-underline-offset: 3px;
  }

  .fn-note a:hover {
    color: var(--sb-accent-ink);
  }

  @media (max-width: 540px) {
    .fn-section {
      font-size: 22px;
    }

    .fn-item {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    /* On phones the stamp flattens into one inline "SEP 18" chip. */
    .fn-stamp {
      flex-direction: row;
      align-items: baseline;
      gap: 6px;
      min-width: 0;
      padding: 4px 10px 4px 9px;
      border-top-width: 1px;
      border-left: 3px solid var(--fn-tone);
      border-radius: var(--sb-radius-xs);
    }

    .fn-stamp-day {
      font-family: var(--sb-mono);
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.06em;
    }

    .fn-stamp--none {
      min-height: 0;
    }

    .fn-name {
      font-size: 18px;
    }
  }
</style>
