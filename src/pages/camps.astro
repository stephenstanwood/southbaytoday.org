---
import SignalShell from "../layouts/SignalShell.astro";
import { CAMPS, LATEST_SEASON } from "../lib/south-bay/campFinder";
---

<SignalShell
  title={`Summer Camps ${LATEST_SEASON} in Santa Clara County — South Bay Today`}
  description={`Compare ${CAMPS.counts.programs} summer camp programs across Santa Clara County by age, week, price and financial aid, each taken from the camp's own pages.`}
  initialTab="camps"
  ogImage="https://southbaytoday.org/og/og-camps.jpg"
/>
