---
import BaseLayout from "./BaseLayout.astro";
import SignalApp from "../components/south-bay/SignalApp.tsx";
import EventsApp from "../components/south-bay/apps/EventsApp.tsx";
import GovApp from "../components/south-bay/apps/GovApp.tsx";
import TechApp from "../components/south-bay/apps/TechApp.tsx";
import FoodApp from "../components/south-bay/apps/FoodApp.tsx";
import CampsApp from "../components/south-bay/apps/CampsApp.tsx";
import type { Tab } from "../lib/south-bay/types";

interface Props {
  title?: string;
  description?: string;
  initialTab?: Tab;
  /** absolute URL for og:image / twitter:image (defaults to the site card) */
  ogImage?: string;
}

// Site styles load once for every page from BaseLayout (src/styles/sbt/).
// The app shell server-renders at build time (client:load) on every page,
// homepage included: crawlers and first paint get the masthead/nav/footer
// plus each view's deterministic initial HTML. Views keep their first render
// free of clock/localStorage/random reads (refined in mounted effects) so
// hydration matches the build's HTML.
const {
  title = "The South Bay Today",
  description = "What should we do today? Day plans, events, restaurants, and parks across Campbell, Los Gatos, Mountain View, San José, Palo Alto, and six more South Bay cities.",
  initialTab,
  ogImage,
} = Astro.props;

// The Events view renders "today" (day title, date rail) into this HTML. It
// hydrates against the build's day, then switches to the reader's.
const buildDayPt = new Date().toLocaleDateString("en-CA", { timeZone: "America/Los_Angeles" });
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  themeColor="#FFF8F2"
>
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>

  {/* Each tab page hydrates an island that bundles its own view eagerly
      (Astro can't put client:* on a dynamic tag, hence the explicit list). */}
  {initialTab === "events" ? <EventsApp client:load buildDayPt={buildDayPt} />
    : initialTab === "government" ? <GovApp client:load />
    : initialTab === "technology" ? <TechApp client:load />
    : initialTab === "food" ? <FoodApp client:load />
    : initialTab === "camps" ? <CampsApp client:load />
    : <SignalApp client:load initialTab={initialTab} />}
  <slot />
</BaseLayout>
