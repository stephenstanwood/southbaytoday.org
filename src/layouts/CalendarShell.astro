---
// Shared chrome for the static crawlable pages (/events/<date>, /event/<slug>,
// /gov/<city>, /about, /privacy, /newsletters, 404). Same Masthead + footer as
// the app (server-rendered, no hydration) around a slot; page styles are
// global but namespaced under .cal-page. The only islands are the footer's
// newsletter signup (client:visible) and BaseLayout's feedback widget.
import BaseLayout from "./BaseLayout.astro";
import Masthead, { type MastheadProps } from "../components/south-bay/Masthead";
import SiteFooter from "../components/south-bay/SiteFooter";
import NewsletterSignup from "../components/south-bay/NewsletterSignup";

interface Props {
  title: string;
  description: string;
  /** absolute URL for og:image (e.g. an event's photo) */
  ogImage?: string;
  /** highlight a nav tab when the page corresponds to one; omit/null for sub-routes */
  activeTab?: MastheadProps["activeTab"];
  /** keep the page out of search indexes (retired event leaves) */
  noindex?: boolean;
}

const { title, description, ogImage, activeTab = null, noindex = false } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  themeColor="#FFF8F2"
  noindex={noindex}
>
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>

  <div class="cal-page">
    <Masthead activeTab={activeTab} />

    <main class="cal-main" id="main-content">
      <slot />
    </main>

    <SiteFooter>
      <NewsletterSignup variant="minimal" client:visible />
    </SiteFooter>
  </div>
</BaseLayout>

<style is:global>
  .cal-page {
    --ink: var(--sb-ink);
    --muted: var(--sb-muted);
    --light: var(--sb-light);
    --border: var(--sb-line-strong);
    --border-light: var(--sb-line);
    color: var(--sb-ink);
    font-family: var(--sb-sans);
    min-height: 100vh;
  }
  .cal-main {
    max-width: 760px;
    margin: 0 auto;
    padding: 30px var(--sb-gutter) 56px;
  }
  .cal-daynav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }
  .cal-daynav a {
    font-family: var(--sb-mono);
    font-size: 11.5px;
    font-weight: 700;
    color: var(--sb-ink-2);
    text-decoration: none;
    white-space: nowrap;
    padding: 4px 0;
  }
  .cal-daynav a:hover {
    color: var(--sb-accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cal-kicker {
    font-family: var(--sb-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sb-muted);
  }
  .cal-page h1 {
    font-family: var(--sb-serif);
    font-size: clamp(32px, 5vw, 44px);
    font-weight: 900;
    letter-spacing: -0.015em;
    line-height: 1.04;
    margin: 0 0 10px;
    text-wrap: balance;
  }
  .cal-sub {
    color: var(--sb-muted);
    font-size: 15px;
    line-height: 1.55;
    margin: 0 0 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--sb-line);
  }
  .cal-sub a {
    color: var(--sb-ink-2);
    font-weight: 600;
    text-underline-offset: 3px;
  }
  .cal-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .cal-event {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--sb-line);
  }
  .cal-time {
    font-family: var(--sb-mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--sb-ink-2);
    white-space: nowrap;
    padding-top: 4px;
  }
  .cal-body h2 {
    font-family: var(--sb-serif);
    font-size: 20px;
    font-weight: 800;
    line-height: 1.25;
    margin: 0 0 5px;
    text-wrap: pretty;
  }
  .cal-body h2 a {
    color: var(--sb-ink);
    text-decoration: none;
  }
  .cal-body h2 a:hover {
    color: var(--sb-accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .cal-meta {
    margin: 0;
    font-size: 13px;
    color: var(--sb-muted);
  }
  .cal-chip {
    display: inline-block;
    margin-left: 8px;
    padding: 1px 8px;
    border: 1px solid #bbf7d0;
    background: #f0fdf4;
    color: #15803d;
    border-radius: 999px;
    font-family: var(--sb-mono);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    vertical-align: 1px;
  }
  .cal-chip--kids {
    border-color: #fde68a;
    background: #fffbeb;
    color: #b45309;
  }
  .cal-chip--virtual {
    border-color: #bfdbfe;
    background: #eff6ff;
    color: #1d4ed8;
  }
  .cal-copy {
    margin: 7px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--sb-muted);
    max-width: 62ch;
  }
  @media (max-width: 540px) {
    .cal-event {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .cal-time {
      padding-top: 0;
    }
  }
</style>
